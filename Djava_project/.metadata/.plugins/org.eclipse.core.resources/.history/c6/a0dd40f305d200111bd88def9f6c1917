package app;

import javax.swing.*;
import java.awt.*;

public class main1 extends JFrame {

    // Панель для динамічного відображення списку задач
    private final JPanel todoPanel;

    public Main() {
        // 1. Базові налаштування вікна
        setTitle("To-Do List");
        setSize(500, 400);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        // 2. Встановлення основного менеджера компонування
        setLayout(new BorderLayout(10, 10));
        
        // Додаємо відступи навколо всього контенту всередині вікна
        ((JPanel) getContentPane()).setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        // 3. Верхня панель: Створення нової задачі
        var topPanel = new JPanel(new BorderLayout(10, 0));
        
        var label = new JLabel("Нова задача: [");
        var textField = new JTextField();
        var endLabel = new JLabel("]");
        
        var inputFieldPanel = new JPanel(new BorderLayout(5, 0));
        inputFieldPanel.add(label, BorderLayout.WEST);
        inputFieldPanel.add(textField, BorderLayout.CENTER);
        inputFieldPanel.add(endLabel, BorderLayout.EAST);

        var addButton = new JButton("Додати");

        topPanel.add(inputFieldPanel, BorderLayout.CENTER);
        topPanel.add(addButton, BorderLayout.EAST);
        add(topPanel, BorderLayout.NORTH);

        // 4. Центральна панель: Список задач (із чекбоксами)
        todoPanel = new JPanel();
        todoPanel.setLayout(new BoxLayout(todoPanel, BoxLayout.Y_AXIS));
        todoPanel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        // 5. Початкові елементи списку задач (як на скриншоті)
        var task1 = new JCheckBox("Вивчити Swing");
        var task2 = new JCheckBox("Виконати лабораторну");
        var task3 = new JCheckBox("Завантажити проєкт");

        task2.setSelected(true);

        todoPanel.add(task1);
        todoPanel.add(task2);
        todoPanel.add(task3);

        var scrollPane = new JScrollPane(todoPanel);
        scrollPane.setBorder(BorderFactory.createLineBorder(Color.GRAY, 1));
        add(scrollPane, BorderLayout.CENTER);

        // 6. Нижня панель: Керування (Кнопки "Видалити" та "Очистити")
        var bottomPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT, 10, 0));
        
        var deleteButton = new JButton("Видалити");
        var clearButton = new JButton("Очистити");

        bottomPanel.add(deleteButton);
        bottomPanel.add(clearButton);
        add(bottomPanel, BorderLayout.SOUTH);

        // 7. ЛОГІКА КНОПОК (Обробники подій)

        // Кнопка "Додати": бере текст із поля та створює новий JCheckBox
        addButton.addActionListener(e -> {
            var text = textField.getText().trim();
            if (!text.isEmpty()) {
                todoPanel.add(new JCheckBox(text));
                textField.setText(""); // Очищаємо поле введення
                refreshTodoPanel();
            }
        });

        // Альтернативне додавання через Enter у текстовому полі
        textField.addActionListener(e -> addButton.doClick());

        // Кнопка "Видалити": прибирає зі списку лише ті задачі, де стоїть галочка
        deleteButton.addActionListener(e -> {
            var components = todoPanel.getComponents();
            for (var component : components) {
                if (component instanceof JCheckBox checkBox) {
                    if (checkBox.isSelected()) {
                        todoPanel.remove(checkBox);
                    }
                }
            }
            refreshTodoPanel();
        });

        // Кнопка "Очистити": видаляє абсолютно всі задачі зі списку
        clearButton.addActionListener(e -> {
            todoPanel.removeAll();
            refreshTodoPanel();
        });
    }

    // Допоміжний метод для оновлення інтерфейсу після додавання/видалення елементів
    private void refreshTodoPanel() {
        todoPanel.revalidate();
        todoPanel.repaint();
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new Main().setVisible(true);
        });
    }
}
